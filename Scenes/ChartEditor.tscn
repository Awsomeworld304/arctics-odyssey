title = "Chart Error"
initial_position = 2
size = Vector2i(400, 400)
min_size = Vector2i(400, 400)
max_size = Vector2i(400, 400)
content_scale_mode = 2
content_scale_aspect = 1
content_scale_stretch = 1
theme = ExtResource("6_iqyyb")

[node name="ErrTxt" type="Label" parent="main/ErrorPopup"]
offset_left = 8.0
offset_top = 8.0
offset_right = 392.0
offset_bottom = 369.0
theme = ExtResource("6_iqyyb")
theme_override_font_sizes/font_size = 32
text = "An error has occured while loading the chart:
{CHART_NAME}
{CHART_PATH}

In mod:
{MOD_NAME}

The default chart has been loaded.
If this keeps happening, your chart is most likley corrupted."
autowrap_mode = 3

[connection signal="tree_exiting" from="." to="." method="_on_tree_exiting"]
[connection signal="button_up" from="main/ChartMenu/Chart/ReloadChart" to="." method="_on_reload_chart_button_up"]
[connection signal="button_up" from="main/ChartMenu/Chart/PlayChart" to="." method="_on_play_chart_button_up"]
[connection signal="button_up" from="main/ChartMenu/Chart/StopChart" to="." method="_on_stop_chart_button_up"]
[connection signal="value_changed" from="main/ChartMenu/Chart/NoteSpeedBox" to="." method="_on_note_speed_box_value_changed"]
[connection signal="button_up" from="main/ChartMenu/Note/PlusZoom" to="." method="_on_plus_zoom_button_up"]
[connection signal="mouse_exited" from="main/ChartMenu/Note/PlusZoom" to="." method="_on_plus_zoom_mouse_exited"]
[connection signal="button_up" from="main/ChartMenu/Note/MinusZoom" to="." method="_on_minus_zoom_button_up"]
[connection signal="mouse_exited" from="main/ChartMenu/Note/MinusZoom" to="." method="_on_minus_zoom_mouse_exited"]
[connection signal="button_up" from="main/_TimeSliderBG/_TimeSliderTitleBG/SliderMinim" to="." method="_on_slider_minim_button_up"]
[connection signal="drag_ended" from="main/_TimeSliderBG/TimeSlider" to="." method="_on_time_slider_drag_ended"]
[connection signal="value_changed" from="main/_TimeSliderBG/TimeSlider" to="." method="_on_time_slider_value_changed"]
