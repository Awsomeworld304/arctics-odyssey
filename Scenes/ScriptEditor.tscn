text = "extends StoryScript

# This gets ran first.
func script() -> void:
	# Use add_line(\"\") to add a line!
	# Use add_event(event) to add an event!
	# Please note that you have to program your events here.
	add_line(\"Test run!\");
	add_event(example_event);
	# This is very important!
	# If you forget this, your script will be ignored!
	register(); 
	pass

func example_event() -> void:
	print(\"Event ran!\");
	pass"
