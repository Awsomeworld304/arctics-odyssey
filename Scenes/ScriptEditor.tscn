min_size = Vector2i(400, 400)
keep_title_visible = true
theme_override_fonts/title_font = ExtResource("8_3cg2f")
script = SubResource("GDScript_bujqu")

[node name="auto_parse" type="CheckButton" parent="editor/editor_options"]
offset_right = 400.0
offset_bottom = 31.0
tooltip_text = "Every time you edit in the code editor, the code will be checked.
This can be resource intensive when working with big scripts!"
text = "Auto Parse Code on Edit"

[connection signal="button_up" from="editor/bar/exit" to="." method="_on_exit_button_up"]
[connection signal="button_up" from="editor/bar/editor_opt" to="." method="_on_editor_opt_button_up"]
[connection signal="code_completion_requested" from="editor/edit/editor" to="editor/edit/editor" method="_on_code_completion_requested"]
[connection signal="text_changed" from="editor/edit/editor" to="." method="_on_editor_text_changed"]
[connection signal="button_up" from="editor/edit/load_script" to="." method="_on_load_script_button_up"]
[connection signal="button_up" from="editor/edit/save_script" to="." method="_on_save_script_button_up"]
[connection signal="button_up" from="editor/edit/reload_code" to="." method="_on_reload_code_button_up"]
[connection signal="file_selected" from="editor/load_dialog" to="." method="_on_load_dialog_file_selected"]
[connection signal="canceled" from="editor/save_dialog" to="." method="_on_save_dialog_canceled"]
[connection signal="file_selected" from="editor/save_dialog" to="." method="_on_save_dialog_file_selected"]
[connection signal="close_requested" from="editor/editor_options" to="editor/editor_options" method="_on_close_requested"]
[connection signal="toggled" from="editor/editor_options/auto_parse" to="." method="_on_auto_parse_toggled"]
