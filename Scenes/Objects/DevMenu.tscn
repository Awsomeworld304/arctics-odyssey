[sub_resource type="GDScript" id="GDScript_kbrna"]
resource_name = "dick"
script/source = "extends CanvasLayer


func _on_vn_button_up() -> void:
	LevelManager.load_scene(\"story\");
	pass # Replace with function body.


func _on_battle_button_up() -> void:
	LevelManager.load_scene(\"stage\");
	pass # Replace with function body.


func _on_scripteditor_button_up() -> void:
	LevelManager.load_scene(\"ScriptEditor\");
	pass # Replace with function body.


func _on_charteditor_button_up() -> void:
	LevelManager.load_scene(\"ChartEditor\");
	pass # Replace with function body.


func _on_teststage_button_up() -> void:
	LevelManager.load_scene(\"test_stage\", true);
	pass # Replace with function body.


func _on_tab_bar_tab_changed(tab: int) -> void:
	match tab:
		0:
			($menu/scenes as Panel).visible = true;
			($menu/tools as Panel).visible = false;
		1:
			($menu/scenes as Panel).visible = false;
			($menu/tools as Panel).visible = true;
	pass


func _on_toolkit_button_up() -> void:
	LevelManager.load_scene(\"Toolkit\");
	pass
"

